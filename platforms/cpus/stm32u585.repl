// Bachelorarbeit STM32u585 config file

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 32000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

flashreg: Miscellaneous.STM32U585_Flash @ sysbus 0x40022000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xC4400

usart1: UART.STM32F7_USART @ sysbus 0x40004400 //0x40013800
    frequency: 160000000
    IRQ -> nvic@61

rtc: Timers.STM32U585_RTC @ sysbus 0x40002800
    AlarmIRQ -> nvic@41
rcc: Miscellaneous.STM32U585_RCC @ sysbus 0x46020C00
    rtcPeripheral: rtc
pwr: Miscellaneous.STM32U585_PWR @ sysbus 0x46020800

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    numberOfAFs: 16
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    numberOfAFs: 16
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    numberOfAFs: 16
gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16
gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16
gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>
    numberOfAFs: 16
gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16
gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    numberOfAFs: 16
gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>
    numberOfAFs: 16

spi1: SPI.STM32H7_SPI @ sysbus 0x40013000
spi2: SPI.STM32H7_SPI @ sysbus 0x40003800
spi3: SPI.STM32H7_SPI @ sysbus 0x46002000





