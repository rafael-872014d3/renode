// Bachelorarbeit STM32u585 config file

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 32000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

flashreg: Miscellaneous.STM32U585_Flash @ sysbus 0x40022000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xC4400

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 160000000
    IRQ -> nvic@61

rtc: Timers.STM32U585_RTC @ sysbus 0x40002800
    AlarmIRQ -> nvic@41
rcc: Miscellaneous.STM32U585_RCC @ sysbus 0x46020C00
    rtcPeripheral: rtc
pwr: Miscellaneous.STM32U585_PWR @ sysbus 0x46020800



gpioPortA: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42020000, +0x400>
    numberOfAFs: 16
gpioPortB: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42020400, +0x400>
    numberOfAFs: 16
gpioPortC: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42020800, +0x400>
    numberOfAFs: 16
gpioPortD: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16
gpioPortF: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42021400, +0x400>
    numberOfAFs: 16
gpioPortG: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16
gpioPortH: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42021C00, +0x400>
    numberOfAFs: 16
gpioPortI: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42022000, +0x400>
    numberOfAFs: 16
gpioPortE: GPIOPort.STM32U585_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16

can1: CAN.MCAN @ sysbus <0x4000A400, +0x400>
    Line0 -> nvic@39
    Line1 -> nvic@40
    messageRAM: canMessageRAM

canMessageRAM: Memory.ArrayMemory @ sysbus <0x4000B400, +0x800>
    size: 0x2800

spi1: SPI.STM32U585_SPI @ sysbus 0x40013000
spi2: SPI.STM32U585_SPI @ sysbus 0x40003800
spi3: SPI.STM32U585_SPI @ sysbus 0x46002000

w25q64: SPI.GenericSpiFlash @ spi3
    size: 0x800000
    manufacturerId: 0xEF
    memoryType: 0x40

gpioPortC:
    9 -> w25q64@0

w25q64_mem: Memory.PersistentArrayMemory @ w25q64 0
    size: 0x800000
    paddingVal: 0xFF
    saveOnReset: true

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 1000 

adc1: Analog.STM32U585_ADC1 @ sysbus 0x42028000
    referenceVoltage: 3.0
    externalEventFrequency: 10000
    adcSelection: 12
    IRQ -> nvic@37

adc4: Analog.STM32U585_ADC4 @ sysbus 0x46021000
    referenceVoltage: 3.0
    externalEventFrequency: 10000
    adcSelection: 4
    IRQ -> nvic@113

otp: Memory.MappedMemory @ sysbus 0x0BFA0000
    size: 0x8000

sysbus:
    init:
        ApplySVD @resc\STM32U585.svd






