# === STM32U585_8756_bues Simulation ===

# Create Machine
mach create "STM32U585_8756_bues"

# Load Platform Description
machine LoadPlatformDescription @platforms/cpus/stm32u585.repl

# Load Firmware 
#sysbus LoadELF @C:\Workspace\8756_bueS\A.17.00\cmake-build-GNU_STM32U5_Debug\UserArea\UserArea.elf
sysbus LoadELF @C:\Workspace\8756_bueS\trunk\cmake-build-GNU_STM32U5_Debug\UserArea\UserArea.elf

# Load SPI flash image
spi3.w25q64.w25q64_mem LinkFile "resc/flash.img"

# Start Debugger
machine StartGdbServer 3333 true

# Set Voltage to 24V
adc4 SetDefaultValue 1700 11

# Set LogLevel
logLevel 1

# Set GPIOPins
gpioPortB OnGPIO 10 true
gpioPortB OnGPIO 14 true

gpioPortA OnGPIO 10 true
gpioPortA OnGPIO 11 true


# Load JSON sensor replay data
i2c2.sensor LoadJson "src/Infrastructure/src/Emulator/Peripherals/Peripherals/Sensors/Coriolis_Replaysensor/Recordings/04.03.26_Rampe100-0.json"
logLevel 1 i2c2.sensor

# Setup CAN interface
emulation CreateCANHub "canHub"
# machine CreateMqttCanBridge "mqttCan" "protobuf" "mqtt://localhost:1883" 0 0
connector Connect can1 canHub
# connector Connect mqttCan canHub

# Setup CanOpenBitBanging 
machine CreateCANOpenBitBanging "canOpenBitBanging"
connector Connect canOpenBitBanging canHub
canOpenBitBanging ConnectCoriolisSensor i2c2.sensor


