# === STM32U585_8756_bues Simulation ===

mach create "STM32U585_8756_bues"

machine LoadPlatformDescription @platforms/cpus/stm32u585.repl

# sysbus.cpu LogFunctionNames True

# cpu VectorTableOffset 0x08000000

sysbus LoadELF @C:\Workspace\8756_bueS\A.17.00\cmake-build-GNU_STM32U5_Debug\UserArea\UserArea.elf

: load spi flash image
logLevel -1 spi3.w25q64.w25q64_mem
# spi3.w25q64.w25q64_mem LinkFile resc/flash.img

machine StartGdbServer 3333

start

